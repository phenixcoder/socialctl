{
  "name": "socialctl",
  "version": "0.2.0",
  "description": "CLI-first, GitOps-style social media control system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "socialctl": "./dist/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phenixcoder/socialctl.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
